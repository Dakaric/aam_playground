# Anwendung
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres
POSTGRES_USER=postgres
POSTGRES_DB=app
POSTGRES_PASSWORD=change-me
# Wichtig: Hier KEINE ${...}-Interpolation verwenden. Passwort direkt einsetzen.
DATABASE_URL=postgresql://${POSTGRES_USER}:change-me@db:5432/${POSTGRES_DB}?schema=public

# Auth
ADMIN_TOKEN=please-change-me
# Für lokale Übungen kann AUTH_DISABLED=true gesetzt werden
AUTH_DISABLED=false

# n8n (Basic Auth aktiv, auch wenn nur lokal erreichbar)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# n8n E-Mail (lokal via Mailpit)
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=mailpit
N8N_SMTP_PORT=1025
N8N_SMTP_SSL=false
N8N_SMTP_USER=
N8N_SMTP_PASS=
N8N_SMTP_SENDER="n8n <no-reply@localhost>"
N8N_PROTOCOL=http
# Lokal: Host erzeugt Links in E-Mails; für Server Domain eintragen
N8N_HOST=localhost:5678
# Optional: Setzen, wenn n8n hinter einem Proxy/Domain erreichbar ist
N8N_WEBHOOK_URL=

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# LiveKit (Voice Agent)
# Lokaler Dev-Server standardmäßig auf Port 7880
LIVEKIT_URL=ws://localhost:7880
# Dev-Keys für lokalen LiveKit-Server im --dev Modus
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Optionaler Default-Raumname
LIVEKIT_DEFAULT_ROOM=voice-agent

# OpenAI (für Agent)
OPENAI_API_KEY=

# Agent Konfiguration (über LiveKit Agents, Python)
# true = OpenAI Realtime (LLM+TTS+STT in einem), false = getrennte Modelle
AGENT_USE_REALTIME=true

# Realtime‑Variante (wenn AGENT_USE_REALTIME=true)
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_VOICE=alloy

# Getrennte Modelle (wenn AGENT_USE_REALTIME=false)
AGENT_STT_MODEL=openai/whisper-1
AGENT_LLM_MODEL=openai/gpt-4o-mini
AGENT_TTS_MODEL=openai/tts-1

# Optional: Agent‑Prompt
AGENT_INSTRUCTIONS=Du bist ein hilfreicher deutschsprachiger Voice‑Assistent. Antworte kurz und freundlich.
